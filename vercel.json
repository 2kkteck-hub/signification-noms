{
  "version": 2,
  "name": "signification-noms",
  "routes": [
    {
      "src": "/css/(.*)",
      "headers": {
        "Content-Type": "text/css"
      },
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "headers": {
        "Content-Type": "application/javascript"
      },
      "dest": "/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}